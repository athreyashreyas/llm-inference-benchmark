# =============================================================================
# FILL BEFORE RUNNING — obtained manually from platform UIs
# =============================================================================

# --- Simplismart ---
# API key (also called "PG Token"): app.simplismart.ai > Settings > API Keys
SIMPLISMART_API_KEY=your_key_here

# Org UUID: app.simplismart.ai > Settings > Organisation (shown as UUID)
SIMPLISMART_ORG_ID=your_org_uuid_here

# Model compiled and deployed on Simplismart — populated by deploy script
# HuggingFace source: google/gemma-3-4b-it
SIMPLISMART_MODEL_ID=google/gemma-3-4b-it

# GPU for dedicated deployment — H100 80GB
SIMPLISMART_GPU_ID=nvidia-h100

# --- Fireworks AI ---
# API key: fireworks.ai > Dashboard > API Keys
FIREWORKS_API_KEY=your_key_here

# Account ID: fireworks.ai > Dashboard > Settings
# Used to construct inference path: accounts/<ACCOUNT_ID>/deployments/<DEPLOYMENT_ID>
FIREWORKS_ACCOUNT_ID=your_account_id_here

# Base model to deploy on Fireworks — H100 80GB
FIREWORKS_BASE_MODEL_ID=accounts/fireworks/models/gemma-3-4b-it

# =============================================================================
# FILLED AUTOMATICALLY after deployment — do not set manually
# =============================================================================

# Simplismart: deployment-specific inference endpoint returned by create_deployment()
# Populated by deploy/deploy_simplismart.py after successful deployment
SIMPLISMART_BASE_URL=

# Simplismart: compiled model repo UUID — written by deploy script after successful compile
# Set manually to skip recompilation: python deploy/deploy_simplismart.py --deploy-only
SIMPLISMART_MODEL_REPO_UUID=

# Simplismart: deployment UUID — used by teardown script
SIMPLISMART_DEPLOYMENT_ID=

# Fireworks: deployment ID returned by deploy/deploy_fireworks.py
# Full inference model ID becomes: accounts/<FIREWORKS_ACCOUNT_ID>/deployments/<DEPLOYMENT_ID>
FIREWORKS_DEPLOYMENT_ID=

# Fireworks: full inference model path written by deploy script
FIREWORKS_MODEL_ID=
